{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV", "WEB_URL", "NEXT_PUBLIC_API_URL", "NEXT_OUTPUT"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "API_INTERNAL_URL",
    "JWT_SECRET",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_S3_BUCKET",
    "AWS_S3_URL",
    "S3_PATH",
    "SENDGRID_API_KEY",
    "OPENAI_API_KEY",
    "GOOGLE_CLOUD_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test:ci": {
      "cache": false
    },
    "lint:check": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    }
  }
}
