{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "WEB_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_FILES_URL",
    "NEXT_OUTPUT",
    "FILES_FALLBACK",
    "AWS_S3_BUCKET",
    "AWS_S3_URL",
    "AWS_ENDPOINT_URL_S3",
    "AWS_REGION"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "API_INTERNAL_URL",
    "JWT_SECRET",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "S3_PATH",
    "SENDGRID_API_KEY",
    "OPENAI_API_KEY",
    "GOOGLE_CLOUD_API_KEY",
    "API_PUBLIC_URL",
    "UPLOAD_DIR",
    "AWS_S3_FORCE_PATH_STYLE",
    "SMTP_URL",
    "MAIL_FROM"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test:ci": {
      "cache": false
    },
    "lint:check": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    }
  }
}
