# One public origin for the whole stack:
#   /api/*    -> API (prefix stripped)
#   /files/*  -> uploaded files: FILES_UPSTREAM + FILES_PREFIX + the rest
#   /docs/*   -> the documentation site (prefix kept, it is built for it)
#   the rest  -> web
#
# SITE_ADDRESS defaults to plain HTTP on port 80. Set it to a domain
# (e.g. biosfera.example.com) and Caddy obtains and renews a certificate.
#
# The web image reads files from /files on its own origin, so where they
# really live is decided here, at runtime:
#   bundled SeaweedFS  s3:8333                                  /<bucket>
#   any other bucket   https://<bucket>.s3.<region>.amazonaws.com  (empty)
#   the API's disk     api:5500                                 /blobs/file
{
	# Behind another proxy (production) the client address and scheme arrive in
	# X-Forwarded-* headers; accept them from private networks only.
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:5500
	}

	handle_path /files/* {
		rewrite * {$FILES_PREFIX}{uri}
		reverse_proxy {$FILES_UPSTREAM:s3:8333} {
			# Hosted stores route by Host, so send the upstream's own.
			header_up Host {upstream_hostport}
		}
	}

	redir /docs /docs/ 308
	handle /docs/* {
		reverse_proxy docs:80
	}

	handle {
		reverse_proxy web:3000
	}
}
