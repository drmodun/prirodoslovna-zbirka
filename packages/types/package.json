{
  "name": "@biosfera/types",
  "version": "1.1.0",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "require": "./dist/*.js",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "class-validator": "^0.14.0"
  },
  "devDependencies": {
    "typescript": "^5.1.6"
  }
}
