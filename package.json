{
  "name": "biosfera",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "dotenv -- turbo run build",
    "dev": "dotenv -- turbo run dev",
    "start": "cd apps/api && yarn start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint:check": "turbo run lint:check",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.1.0",
    "turbo": "^2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "lodash": "^4.18.1",
    "multer": "2.4.0",
    "qs": "6.16.0",
    "postcss": "8.5.30",
    "decode-uri-component": "0.5.0",
    "tar": "^7.5.22",
    "**/@nestjs/swagger/js-yaml": "5.5.0"
  }
}
