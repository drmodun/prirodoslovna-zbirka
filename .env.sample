# Copy to .env in the repo root. Both apps read it from here.
# Only the "Required" block is needed to run everything; each optional
# integration has a built-in fallback that is used while its keys are empty.

# --- Required ---------------------------------------------------------------
# "development" also allows `yarn workspace api seed` to run.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biosfera
JWT_SECRET=change-me
# Public address of the web app. Used for links in emails and notifications.
WEB_URL=http://localhost:3000

# --- Optional: addresses ----------------------------------------------------
# Where the browser reaches the API. Read at web build time.
# Defaults to http://localhost:5500, or ${WEB_URL}/api when WEB_URL is not local.
NEXT_PUBLIC_API_URL=
# Where the web server reaches the API, if different (e.g. http://api:5500 in compose).
API_INTERNAL_URL=
# Where the browser reaches the API when it serves uploads itself (see below).
API_PUBLIC_URL=

# --- Optional: file uploads (S3 or any S3-compatible store) -----------------
# Needs ACCESS_KEY_ID, SECRET_ACCESS_KEY and BUCKET. The bucket must allow
# anonymous reads, since browsers load files from it directly.
# Fallback: the API stores files in UPLOAD_DIR and serves them at
# /blobs/file/<directory>/<name>.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Defaults to eu-north-1. Self-hosted stores usually accept any value.
AWS_REGION=
# Leave empty for AWS. For MinIO, Garage, SeaweedFS, R2 and the like, the
# address the API reaches the store at, e.g. http://s3:8333.
AWS_ENDPOINT_URL_S3=
# true = <endpoint>/<bucket>, false = <bucket>.<endpoint>. Defaults to true
# when an endpoint is set.
AWS_S3_FORCE_PATH_STYLE=
# Address browsers read files from. Defaults to <endpoint>/<bucket>, or the
# bucket's AWS address. Set it when the endpoint above is internal or the
# files sit behind a CDN or reverse proxy. Also read at web build time.
AWS_S3_URL=
UPLOAD_DIR=
# Overrides where the web app reads uploads from. Read at web build time.
NEXT_PUBLIC_FILES_URL=

# --- Optional: email --------------------------------------------------------
# Account activation and password reset. Either works; SMTP wins if both are
# set. Fallback: the message, including its link, is written to the API log.
# Any SMTP server, self-hosted or a provider's relay:
#   smtp://user:password@mail.example.com:587   (STARTTLS)
#   smtps://user:password@mail.example.com:465  (TLS)
# Gmail: an app password (needs 2-step verification), "@" written as %40,
# and MAIL_FROM set to the same address:
#   smtp://name%40gmail.com:app-password@smtp.gmail.com:587
SMTP_URL=
SENDGRID_API_KEY=
# Sender address. Defaults to biosfera.trema@gmail.com; must be one your mail
# server or SendGrid account is allowed to send as.
MAIL_FROM=

# --- Optional: AI text and speech-to-text ------------------------------------
# Exponat descriptions, post summaries and voice input. Works with any
# OpenAI-compatible API: OpenAI, OpenRouter, Groq, Mistral, or a local server
# such as Ollama (OPENAI_BASE_URL=http://localhost:11434/v1, no key needed).
# Fallback: the Wikipedia lead paragraph for descriptions, the opening
# sentences of the post for summaries, the browser's speech recognition for
# voice input.
OPENAI_API_KEY=
# Defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=
# Chat model. Defaults to gpt-3.5-turbo-0125.
OPENAI_MODEL=
# Transcription model for voice input, whisper-1 unless set. Many providers
# have none: set it to nothing (OPENAI_TRANSCRIPTION_MODEL=) to use the
# browser's speech recognition instead.
#OPENAI_TRANSCRIPTION_MODEL=

# --- Optional: text-to-speech -----------------------------------------------
# TTS_URL is a Piper HTTP server (docker/piper; compose runs one with a Serbian
# voice at http://piper:5000) and wins over the Google Cloud key. Recordings
# are kept in file storage and made once per text.
# Fallback: the play button reads the text with the browser's speech synthesis.
TTS_URL=
GOOGLE_CLOUD_API_KEY=

# --- Docker Compose only ----------------------------------------------------
# The address people open. WEB_URL, the API address (<PUBLIC_URL>/api) and the
# files address (<PUBLIC_URL>/files) follow from it unless set above.
#PUBLIC_URL=http://localhost
# What the Caddy proxy listens on. A domain name makes it fetch a certificate.
#SITE_ADDRESS=:80
# Compose runs its own S3 store (SeaweedFS) and uses it unless the AWS_*
# variables above are set. To use AWS itself, set the keys and bucket and
# clear the bundled defaults: AWS_ENDPOINT_URL_S3= and AWS_S3_URL=
#PIPER_VOICE=sr_RS-serbski_institut-medium
