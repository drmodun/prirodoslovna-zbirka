# Copy to .env.production and fill in. Used with docker-compose.prod.yml:
#   docker compose --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Every optional setting from .env.sample (mail, AI, S3, speech) works here too.

# --- Required ---------------------------------------------------------------
# The address people open, as the main proxy serves it. The web image bakes it
# in: rebuild (--build) after changing it.
PUBLIC_URL=https://biosfera.example.com
# Generate each with: openssl rand -hex 32
JWT_SECRET=
# Lets the web server store text-to-speech recordings in the API.
INTERNAL_API_KEY=
# Avoid characters that need escaping in a URL (@ : / ? #). Postgres only
# applies it when the database volume is first created.
POSTGRES_PASSWORD=
# Credentials of the bundled S3 store, or of your own store if you point
# AWS_ENDPOINT_URL_S3 elsewhere.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Main reverse proxy -----------------------------------------------------
# The Docker network your main proxy is on, and the name this stack answers
# to on it. The main proxy forwards the site to http://<PROXY_ALIAS>:80.
PROXY_NETWORK=proxy
PROXY_ALIAS=biosfera

# --- Mail -------------------------------------------------------------------
# Without one of these, activation links only appear in the API log.
#SMTP_URL=smtp://name%40gmail.com:app-password@smtp.gmail.com:587
#MAIL_FROM=name@gmail.com

# --- AI (any OpenAI-compatible API) -----------------------------------------
#OPENAI_API_KEY=
#OPENAI_BASE_URL=
#OPENAI_MODEL=
