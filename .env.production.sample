# Copy to .env.production and fill in. Used with docker-compose.prod.yml:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# Every optional setting from .env.sample (mail, AI, S3, speech) works here too.

# --- What runs --------------------------------------------------------------
# Bundled services (db, s3, tts) and exactly one way in (caddy, proxy-host
# or proxy-network); see the top of docker-compose.prod.yml.
COMPOSE_PROFILES=db,s3,tts,caddy

# --- Required ---------------------------------------------------------------
# The address people open.
PUBLIC_URL=https://biosfera.example.com
# Generate each with: openssl rand -hex 32
JWT_SECRET=
# Lets the web server store text-to-speech recordings in the API.
INTERNAL_API_KEY=

# --- Images -----------------------------------------------------------------
# Built by .github/workflows/docker-image.yml. "latest" follows master; pin a
# release (e.g. 1.4.0) or a commit SHA to choose when updates happen.
#IMAGE_TAG=latest
#IMAGE_REGISTRY=ghcr.io/drmodun/prirodoslovna-zbirka

# --- Database ---------------------------------------------------------------
# With the db profile: the bundled Postgres's password. Avoid characters that
# need escaping in a URL (@ : / ? #). Postgres only applies it when the
# database volume is first created.
POSTGRES_PASSWORD=
# Without the db profile: your own database.
#DATABASE_URL=postgresql://user:password@db.example.com:5432/biosfera

# --- File storage -----------------------------------------------------------
# With the s3 profile: credentials the bundled store is created with.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Without it, another S3-compatible store: its credentials and bucket above,
# plus where the API reaches it and where Caddy reads files for /files:
#AWS_S3_BUCKET=biosfera-files
#AWS_REGION=eu-north-1
# Empty for AWS itself, else e.g. https://<account>.r2.cloudflarestorage.com
#AWS_ENDPOINT_URL_S3=
#FILES_UPSTREAM=https://biosfera-files.s3.eu-north-1.amazonaws.com
# Empty when FILES_UPSTREAM already names the bucket, else /<bucket>.
#FILES_PREFIX=
# Or no S3 at all: clear the two keys above (files go to the uploads volume)
# and point /files at the API:
#FILES_UPSTREAM=api:5500
#FILES_PREFIX=/blobs/file

# --- Way in -----------------------------------------------------------------
# caddy: certificate for PUBLIC_URL's host; ports 80 and 443 must be free.
# SITE_ADDRESS overrides what Caddy answers to (e.g. several names).
#SITE_ADDRESS=https://biosfera.example.com
# proxy-host: the host's proxy forwards to http://127.0.0.1:8080.
#PROXY_PORT=8080
#PROXY_BIND=127.0.0.1
# proxy-network: the Docker network your main proxy is on, and the name this
# stack answers to there; the main proxy forwards to http://<PROXY_ALIAS>:80.
#PROXY_NETWORK=proxy
#PROXY_ALIAS=biosfera

# --- Mail -------------------------------------------------------------------
# Without one of these, activation links only appear in the API log.
#SMTP_URL=smtp://name%40gmail.com:app-password@smtp.gmail.com:587
#MAIL_FROM=name@gmail.com
#SENDGRID_API_KEY=

# --- Speech -----------------------------------------------------------------
# Without the tts profile: set TTS_URL= (empty) or another Piper server, or
# GOOGLE_CLOUD_API_KEY with TTS_URL= .
#TTS_URL=
#GOOGLE_CLOUD_API_KEY=

# --- AI (any OpenAI-compatible API) -----------------------------------------
#OPENAI_API_KEY=
#OPENAI_BASE_URL=
#OPENAI_MODEL=
